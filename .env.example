# ===== LLM Provider =====
# anthropic(默认)或 openai
PROVIDER_TYPE=anthropic
# API key;留空则回退到 ~/.claude/settings.json 中的 ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY
PROVIDER_API_KEY=
# 自定义端点(代理 / 兼容网关),留空走官方
PROVIDER_BASE_URL=
# 模型名
ANTHROPIC_MODEL=

# ===== 网络搜索(按优先级回退:AnySearch -> Tavily -> Brave -> DuckDuckGo)=====
ANY_SEARCH_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ===== 记忆(向量检索)=====
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== 企业微信(未配置则跳过 WeCom 接入)=====
WECOM_BOT_ID=
WECOM_SECRET=

# ===== 运行时(均可选)=====
PORT=8080
# MAX_AGENT_ITERATIONS=50
# TOOL_TIMEOUT_MS=300000
# TOOL_DEFER_LOADING=1
# PRINCIPLES_EVAL=0
# LOG_LEVEL=info
